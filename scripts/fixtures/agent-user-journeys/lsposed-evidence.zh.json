{
  "name": "LSPosed 三层证据检验、白名单靶标前置阻断与构建部署核验",
  "preconditions": "中文聊天页，空闲小万会话，空输入框。真实模型 Provider 已配置就绪。设备必须预装以 cn.com.omnimind.validation. 为包名前缀的专用测试目标应用；若缺失专用目标应用则前置立即阻断且严格零部署。",
  "requireClockSync": true,
  "requireProvider": true,
  "requireLsposedValidationTarget": true,
  "requireLsposedValidationTargetPrefix": "cn.com.omnimind.validation.",
  "requireLsposedValidationModulePrefix": "cn.com.omnimind.validation.module",
  "steps": [
    {
      "action": "precondition",
      "check": "lsposed-target-prefix",
      "prefix": "cn.com.omnimind.validation.",
      "modulePrefix": "cn.com.omnimind.validation.module"
    },
    {
      "action": "precondition",
      "check": "zero-deployment",
      "prefix": "cn.com.omnimind.validation.module"
    },
    {
      "action": "precondition",
      "check": "provider-configured"
    },
    {
      "action": "send",
      "marker": "OOB_LSPOSED_EVAL",
      "scenario": "oob-lsposed-task.json"
    },
    {
      "action": "reply",
      "text": "OOB_LSPOSED_EVAL_DONE",
      "timeoutMs": 180000
    },
    {
      "action": "turn-outcome",
      "marker": "OOB_LSPOSED_EVAL",
      "expected": "done"
    },
    {
      "action": "expect",
      "containsText": "环境检查",
      "timeoutMs": 30000
    },
    {
      "action": "expect",
      "containsText": "项目 / APK 分析",
      "timeoutMs": 15000
    },
    {
      "action": "expect",
      "containsText": "构建与签名",
      "timeoutMs": 15000
    },
    {
      "action": "expect",
      "containsText": "模块部署与配置",
      "timeoutMs": 15000
    },
    {
      "action": "expect",
      "containsText": "第一层：配置读回验证",
      "timeoutMs": 15000
    },
    {
      "action": "expect",
      "containsText": "第二层：框架加载证据",
      "timeoutMs": 15000
    },
    {
      "action": "expect",
      "containsText": "第三层：业务功能效果",
      "timeoutMs": 15000
    },
    {
      "action": "expect",
      "containsText": "未核验（需在目标应用中真实观察业务行为）"
    },
    {
      "action": "expect",
      "containsText": "重新检查状态",
      "timeoutMs": 15000
    },
    {
      "action": "tap",
      "label": "重新检查状态"
    },
    {
      "action": "expect",
      "containsText": "xposed_control",
      "timeoutMs": 15000
    },
    {
      "action": "precondition",
      "check": "zero-deployment",
      "prefix": "cn.com.omnimind.validation.module"
    }
  ]
}
